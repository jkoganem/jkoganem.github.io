---
// TODO: replace with real posts when written

const posts = [
  {
    title: 'From PDEs to Quantitative Modeling',
    summary:
      'How training in rigorous mathematical analysis transfers to practical quantitative work.',
    date: 'Coming soon',
    tags: ['math', 'quant'],
    href: '#',
  },
  {
    title: 'PINNs for Options Pricing: A Math-First Perspective',
    summary:
      'Lessons from applying physics-informed neural networks to PDE-based pricing problems.',
    date: 'Coming soon',
    tags: ['scientific ML', 'quant finance'],
    href: '#',
  },
];
---

<section id="writing" class="bg-background py-20">
  <div class="max-w-7xl mx-auto px-6">

    <h2 class="font-serif text-2xl text-cream-100 mb-14">Writing</h2>

    <div class="divide-y divide-border">
      {posts.map(post => (
        <div class="py-7 flex gap-8 items-start">

          <div class="w-28 flex-shrink-0 pt-0.5">
            <span class="text-cream-400 text-xs">{post.date}</span>
          </div>

          <div class="flex-1">
            <a href={post.href}
              class="font-serif text-cream-100 text-base leading-snug
                hover:text-amber-accent transition-colors duration-200">
              {post.title}
            </a>
            <p class="text-cream-300 text-sm mt-1.5 leading-relaxed">{post.summary}</p>
            <div class="flex gap-3 mt-2">
              {post.tags.map(tag => (
                <span class="text-xs text-cream-400">#{tag}</span>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
