---
// TODO: add GitHub URL for PINNs repo

const projects = [
  {
    title: 'PINNs for Options Pricing',
    summary:
      'Physics-informed neural network approaches to PDE-based pricing problems, ' +
      'connecting PDE analysis with ML-based numerical methods.',
    tags: ['PDEs', 'PyTorch', 'scientific ML', 'quant finance'],
    github: 'https://github.com/jkoganem/pinns-options-pricing',
  },
];
---

<section id="projects" class="bg-background py-20">
  <div class="max-w-7xl mx-auto px-6">

    <h2 class="font-serif text-2xl text-cream-100 mb-14">Projects</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map(project => (
        <div class="bg-card border border-border rounded-lg p-6 flex flex-col
          hover:border-amber-accent transition-colors duration-200">

          <h3 class="font-serif text-cream-100 text-base leading-snug mb-3">
            {project.title}
          </h3>

          <p class="text-cream-300 text-sm leading-relaxed flex-1 mb-5">
            {project.summary}
          </p>

          <div class="flex flex-wrap gap-2 mb-5">
            {project.tags.map(tag => (
              <span class="text-xs text-cream-400 border border-border rounded px-2 py-0.5">
                {tag}
              </span>
            ))}
          </div>

          <a href={project.github} target="_blank" rel="noopener"
            class="flex items-center gap-1.5 text-sm text-amber-accent hover:underline self-start">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577
                0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756
                -1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304
                3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931
                0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322
                3.301 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404
                2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84
                1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823
                2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12
                24 5.373 18.627 0 12 0z"/>
            </svg>
            GitHub →
          </a>

        </div>
      ))}
    </div>

  </div>
</section>
