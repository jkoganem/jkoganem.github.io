---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Junichi Koganemaru',
  description = 'Mathematician and researcher.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/coffee-shop.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme CSS variables -->
    <style is:global>
      /* Light mode (default) — values are R G B channels for Tailwind */
      :root {
        --color-bg:       245 240 230;
        --color-surface:  237 232 220;
        --color-card:     229 223 211;
        --color-border:   207 201 188;
        --color-text-100: 28 24 20;
        --color-text-200: 48 44 37;
        --color-text-300: 82 77 70;
        --color-text-400: 112 107 100;
        --color-accent:   160 108 42;
      }

      /* Dark mode */
      .dark {
        --color-bg:       14 14 14;
        --color-surface:  22 22 22;
        --color-card:     28 28 28;
        --color-border:   40 40 40;
        --color-text-100: 245 240 232;
        --color-text-200: 224 217 204;
        --color-text-300: 204 197 181;
        --color-text-400: 168 160 144;
        --color-accent:   200 151 78;
      }

      /* Smooth transition when toggling */
      *, *::before, *::after {
        transition-property: background-color, border-color, color;
        transition-duration: 200ms;
        transition-timing-function: ease;
      }
    </style>

    <!-- Theme engine: runs before first paint to avoid flash -->
    <script is:inline>
      (function () {
        var DARK = {
          '--color-bg':       '14 14 14',
          '--color-surface':  '22 22 22',
          '--color-card':     '28 28 28',
          '--color-border':   '40 40 40',
          '--color-text-100': '245 240 232',
          '--color-text-200': '224 217 204',
          '--color-text-300': '204 197 181',
          '--color-text-400': '168 160 144',
          '--color-accent':   '200 151 78',
        };
        var LIGHT = {
          '--color-bg':       '245 240 230',
          '--color-surface':  '237 232 220',
          '--color-card':     '229 223 211',
          '--color-border':   '207 201 188',
          '--color-text-100': '28 24 20',
          '--color-text-200': '48 44 37',
          '--color-text-300': '82 77 70',
          '--color-text-400': '112 107 100',
          '--color-accent':   '160 108 42',
        };

        window.__applyTheme = function (isDark) {
          var vars = isDark ? DARK : LIGHT;
          var root = document.documentElement;
          for (var k in vars) root.style.setProperty(k, vars[k]);
          root.classList.toggle('dark', isDark);
        };

        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        window.__applyTheme(saved === 'dark' || (!saved && prefersDark));
      })();
    </script>
  </head>
  <body class="bg-background text-cream-200 font-sans antialiased">
    <slot />
  </body>
</html>
